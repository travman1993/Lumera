# Database connection string (Railway provides this automatically on deploy)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/lumera

# JWT secret — generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=replace-with-a-long-random-string

# JWT algorithm — do not change
ALGORITHM=HS256

# Token expiry in minutes — 10080 = 7 days
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of allowed frontend origins
# e.g. https://lumera.tv,https://www.lumera.tv
ALLOWED_ORIGINS=http://localhost:5173
